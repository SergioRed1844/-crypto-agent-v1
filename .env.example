# paper | testnet | live
TRADING_MODE=paper
PAPER_EQUITY=1000
# Va dentro del Pine y viaja en cada alerta
WEBHOOK_SECRET=frase-larga-aleatoria-1
# Distinto al anterior: protege /status, /decisions, /kill, /resume (header x-admin-secret)
ADMIN_SECRET=frase-larga-aleatoria-2
TV_IP_ALLOWLIST=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# true: si Gemini falla, opera solo con reglas (las que valida el backtest). false: sin LLM no hay trade
RULES_ONLY_FALLBACK=true
# Postgres gratis (Neon/Supabase) en prod; sqlite solo local
DATABASE_URL=sqlite:///cryptoagent.db
BINANCE_API_KEY=
BINANCE_SECRET=
# Techo de capital que usa el bot aunque la cuenta tenga más (0 = sin techo)
MAX_BOT_CAPITAL=0
CRYPTOPANIC_API_KEY=
ALLOWED_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT
RISK_PER_TRADE=0.005
MAX_OPEN_POSITIONS=2
FEE_RATE=0.001
MACRO_CALENDAR=macro_calendar.json

# ── v4.2: modelo de contexto (docs/MODELO_CONTEXTO.md) ──
# El servidor lee la señal que generan GitHub Actions desde la rama v4.2-contexto (raw de GitHub):
CONTEXT_REMOTE_BASE=https://raw.githubusercontent.com/SergioRed1844/-crypto-agent-v1/v4.2-contexto/data/context/
CONTEXT_REFRESH_MIN=10
CONTEXT_ENABLED=true
# completo | riesgo (solo alertas on-chain, blackout y datos viejos) | monitor (solo registra)
CONTEXT_MODE=completo
# F&G >= 80 o funding > 0.05% vetan la compra (mejoró el backtest fuera de muestra)
DERIV_STRICT=true
# Vigía on-chain también dentro del servidor (cada 5 min; además del de GitHub Actions cada hora)
CONTEXT_ONCHAIN_LIVE=false
# Alerta crítica (se gastan monedas de la era Satoshi) → vende todo a USDT y activa el kill switch
CONTEXT_EXIT_ON_CRITICAL=true
# "Solo entrar si hay X% de ganancia" (neto de comisiones y slippage)
MIN_NET_GAIN_PCT=0.015
MIN_NET_RR=1.8
SLIPPAGE=0.0005
# Opcionales (en GitHub → Settings → Secrets → Actions, NO aquí): GEMINI_API_KEY, CRYPTOPANIC_API_KEY,
# FRED_API_KEY, SHEETS_WEBAPP_URL, SHEETS_TOKEN
CRYPTOPANIC_PLAN=developer
