# Reemplaza fx.tu-dominio.com (un subdominio gratis de DuckDNS sirve). Caddy saca el certificado TLS solo.
# TradingView solo manda webhooks a los puertos 80/443.
fx.tu-dominio.com {
    @tv path /tv /health
    handle @tv {
        reverse_proxy 127.0.0.1:8080
    }
    handle {
        respond 404
    }
}
