# /etc/fx-agente.env  (chmod 600, dueño root). NUNCA lo subas a git ni lo pegues en un chat.
FX_MODE=practice                     # paper | practice. live solo lo pone un humano tras la compuerta de práctica
# FX_LIVE_CONFIRM=                   # se deja vacío; live exige el texto exacto documentado en docs/FX_AGENTE.md
OANDA_TOKEN=pega-aqui-tu-token-de-la-cuenta-DEMO
OANDA_ACCOUNT_ID=101-001-XXXXXXX-001
FX_WEBHOOK_SECRET=cadena-aleatoria-de-32-caracteres-o-mas
FX_HOST=127.0.0.1
FX_PORT=8080
FX_TRUST_PROXY=1                     # Caddy pone X-Forwarded-For; el puerto 8080 no se expone
FX_STATE_DIR=/var/lib/fx-agente
FX_MODEL_URL=https://raw.githubusercontent.com/SergioRed1844/-crypto-agent-v1/fx-agente/data/fx/model.json
FX_CALENDAR_URL=https://raw.githubusercontent.com/SergioRed1844/-crypto-agent-v1/v4.2-contexto/data/context/calendar.json
FX_PAPER_EQUITY=2000
